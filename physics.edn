;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README: the ISIC 2731 plant draws glass fibre from a heated preform on a
;; draw tower with in-line UV-cured coating, then strands and jackets it into
;; cable. The robots' physical work: holding the draw tower's helium cooling
;; tube so the fibre is cold enough when it enters the coating die, and
;; moving finished cable drums from the jacketing line to dispatch.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-2731"
 :cases
 [{:id :fibre-cool-before-coating
   :kind :thermal
   :procedure "125 um fibre leaving the draw furnace at 1000 C cools in the helium cooling tube until it is below 60 C at the coating die; the cylinder is modelled as a slab of half-thickness r/2 (= volume/surface), insulated mid-plane"
   :params {:thickness-m 3.125e-5 :conductivity-w-mk 1.38 :density-kg-m3 2200.0 :specific-heat-j-kgk 1050.0
            :t0-c 1000.0 :t-hot-c 20.0 :h-back-w-m2k 0.0
            :threshold-c 60.0 :threshold-direction :falling :duration-s 0.6 :nodes 4}
   :sweep {:param :h-front-w-m2k :values [1000.0 2000.0 3000.0 5000.0 8000.0]}
   :quantity :time-to-threshold-s
   :limit {:max 0.12 :basis "estimate: residence in a ~3 m cooling path at ~25 m/s draw speed; the 1000 C entry temperature, the helium-tube h range and the 60 C coating-die temperature are estimates"}
   :boundary {:lo 500.0 :hi 10000.0}}
  {:id :cable-drum-to-dispatch
   :kind :transport
   :procedure "drum-handling AGV carries a finished cable drum from the jacketing line to the dispatch bay (80 m)"
   :params {:mass-kg 900.0 :distance-m 80.0 :v-max-mps 1.0 :a-max-mps2 0.3
            :brake-decel-mps2 0.5 :drive-force-n 800.0 :crr 0.015
            :cog-height-m 0.40 :support-half-length-m 0.60 :payload-cog-height-m 0.90
            :max-time-s 3000.0}
   :sweep {:param :payload-kg :values [300.0 600.0 1000.0 1500.0 2000.0]}
   :quantity :cycle-time-s
   :limit {:max 100.0 :basis "estimate: one drum move per 2-minute slot at the dispatch bay"}
   :boundary {:lo 100.0 :hi 5000.0}}]}
